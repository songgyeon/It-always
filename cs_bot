FALLBACK = "일시적인 오류로 답변을 드리지 못했어요. 잠시 후 다시 시도해 주시거나 상담사 연결을 이용해 주세요."


def register(app, client):
    """Flask app에 CS 데모 라우트를 등록한다. Q 모듈과 무관하게 동작."""

    def _cors(resp):
        # 프론트를 다른 곳(GitHub Pages 등)에 올릴 경우를 대비한 CORS 허용.
        # /cs-demo(같은 오리진)로만 쓸 거면 없어도 무방하다.
        resp.headers["Access-Control-Allow-Origin"] = "*"
        resp.headers["Access-Control-Allow-Headers"] = "Content-Type"
        resp.headers["Access-Control-Allow-Methods"] = "POST, OPTIONS"
        return resp

    @app.route("/cs-reply", methods=["POST", "OPTIONS"])
    def cs_reply():
        if request.method == "OPTIONS":
            return _cors(app.make_response(("", 204)))

        data = request.get_json(silent=True) or {}
        message = (data.get("message") or "").strip()
        brand = data.get("brand", "physislab")
        history = data.get("history") or []

        if not message:
            return _cors(jsonify({"reply": "문의 내용을 입력해 주세요."}))
        if brand not in BRAND_CONTEXT:
            brand = "physislab"

        # 히스토리 정제: role/content만 통과, 최근 10턴, 빈 내용 제거
        messages = []
        for m in history[-10:]:
            role = m.get("role")
            content = (m.get("content") or "").strip()
            if role in ("user", "assistant") and content:
                messages.append({"role": role, "content": content})
        # 마지막이 이번 user 메시지와 중복이면 제거 후 추가
        if messages and messages[-1]["role"] == "user" and messages[-1]["content"] == message:
            messages.pop()
        messages.append({"role": "user", "content": message})

        try:
            response = client.messages.create(
                model=MODEL,
                max_tokens=MAX_TOKENS,
                temperature=TEMPERATURE,
                system=SYSTEM_PROMPT.format(brand_context=BRAND_CONTEXT[brand]),
                messages=messages,
            )
            reply = response.content[0].text.strip()
        except Exception as e:
            print(f"⚠️ [CS-BOT ERROR] {e}")
            reply = FALLBACK

        return _cors(jsonify({"reply": reply, "brand": brand}))

    @app.route("/cs-demo", methods=["GET"])
    def cs_demo():
        return send_file(os.path.join(_BASE_DIR, "static", "cs_demo.html"))
